# ============================================================================
# ModelOptix Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================================================
# Application
# ============================================================================
# Base URL for the application (used for OAuth redirects, emails, etc.)
# Development: http://localhost:3000
# Production: https://modeloptix.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Supabase (Required)
# ============================================================================
# Get these from: Supabase Dashboard > Project Settings > API
# https://supabase.com/dashboard/project/_/settings/api

# Public URL for Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key - safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - NEVER expose to browser, server-side only
# Required for: seed script, background jobs, admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# Upstash Redis (Optional - for rate limiting)
# ============================================================================
# Get from: https://console.upstash.com
# Create a Redis database and get REST credentials

# Upstash REST URL
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io

# Upstash REST Token
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ============================================================================
# Email (Resend)
# ============================================================================
# Get from: https://resend.com/api-keys
# Required for: Waitlist confirmation, transactional emails

RESEND_API_KEY=re_your-api-key

# From email address (must be verified domain or use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=noreply@modeloptix.com

# ============================================================================
# Analytics (PostHog)
# ============================================================================
# Get from: https://posthog.com > Project Settings > Project API Key
# Optional but recommended for product analytics

NEXT_PUBLIC_POSTHOG_KEY=phx_your-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================================
# Environment-Specific Notes
# ============================================================================
#
# PRODUCTION (Railway - main branch):
# - NEXT_PUBLIC_APP_URL=https://modeloptix.com
# - Use production Supabase project
# - Enable all rate limiting via Upstash
#
# STAGING (Railway - develop branch):
# - NEXT_PUBLIC_APP_URL=https://staging.modeloptix.com
# - Use staging Supabase project
# - Optional: Use separate Upstash instance
#
# DEVELOPMENT (Local):
# - NEXT_PUBLIC_APP_URL=http://localhost:3000
# - Use staging Supabase (or local Supabase CLI)
# - Upstash is optional (rate limiting disabled if not configured)
#
# ============================================================================
